<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE VBox>

<?import java.lang.Integer?>
<?import java.lang.Double?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.RadioButton?>

<?import org.controlsfx.glyphfont.Glyph?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.CSComboBox?>

<?import org.code_studio.component.ui.CSComboBoxWarehouse?>

<fx:root
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    type="javafx.scene.layout.VBox">

    <fx:define>
        <Double  fx:id="maxComponentWidth" fx:value="1.7976931348623157E308" />
        <Integer fx:id="comboBoxWidth" fx:value="150" />
        <Integer fx:id="buttonWidth" fx:value="150" />
        <Integer fx:id="shortTextFieldWidth" fx:value="60" />
        <ToggleGroup fx:id="tgpWarehouseType" />
    </fx:define>    

	<!--
    <HBox>
        <padding><Insets top="5" right="0" bottom="5" left="5"/></padding>
        <!-
       	<Label text="Org. jedinica" minWidth="65" /> 
        <CSComboBox fx:id="cbWarehouse" initFactory="true" factoryMethodName="Name" HBox.hgrow="SOMETIMES" maxWidth="$maxComponentWidth" />
       	->
    </HBox>
    -->
    <CSTable fx:id="csTable"
        DTOName="ItemWarehouse"
        VBox.vgrow="ALWAYS"
        topLabelText="MAGACIN"
        topLabelVisible="true"
        addButtonVisible="true"
        viewButtonVisible="false"
        editButtonVisible="false"
        deleteButtonVisible="false"
        searchVisible="true"
        searchTooltipText="Pretraga po: Šifra artikla, Naziv artikla">
        <tableColumns>
            <CSTableColumn displayName="ŠIFRA" methodName="Id"/>
            <CSTableColumn displayName="ŠIFRA ARTIKLA" methodName="ItemId" />
            <CSTableColumn displayName="NAZIV ARTIKLA" methodName="ItemName" />
            <CSTableColumn displayName="KOLIČINA" methodName="Qty" />
            <CSTableColumn displayName="SLOBODNO" methodName="AvailableQty" />
            <CSTableColumn displayName="RED" methodName="RowId" />
            <CSTableColumn displayName="POLICA" methodName="ShelfId" />
            <CSTableColumn displayName="VERTIKALA" methodName="VerticalId" />
        </tableColumns>
        <componentBarItems>
            <HBox fx:id="hbWarehouse" alignment="CENTER_LEFT" visible="false" managed="false">
                <!-- <Label text="Magacin" /> premalo prostora, moram labelu da izbacim -->
                <CSComboBoxWarehouse fx:id="cbWarehouse" HBox.hgrow="SOMETIMES" prefWidth="$comboBoxWidth" maxWidth="$maxComponentWidth" />
                <HBox fx:id="hbWarehouseType" styleClass="box-with-border">
                    <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                    <RadioButton fx:id="rbAll" toggleGroup="$tgpWarehouseType" text="Svi" selected="true" />
                    <RadioButton fx:id="rbRegular" toggleGroup="$tgpWarehouseType" text="Regularni" />
                    <RadioButton fx:id="rbCommission" toggleGroup="$tgpWarehouseType" text="Komisioni" />
                </HBox>
            </HBox>
        </componentBarItems>
    </CSTable>

</fx:root>
