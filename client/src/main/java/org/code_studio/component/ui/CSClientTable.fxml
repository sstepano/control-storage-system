<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE VBox>

<?import java.lang.Integer?>
<?import java.lang.Double?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>

<?import org.controlsfx.glyphfont.Glyph?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.CSComboBox?>

<fx:root
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    type="javafx.scene.layout.VBox">

    <fx:define>
        <Double  fx:id="maxComponentWidth" fx:value="1.7976931348623157E308" />
        <Integer fx:id="buttonWidth" fx:value="150" />
        <Integer fx:id="shortTextFieldWidth" fx:value="60" />
    </fx:define>    

    <HBox fx:id="hbOrgJed" maxWidth="280" alignment="CENTER_LEFT">
        <padding><Insets top="5" right="0" bottom="5" left="5"/></padding>
        <Label text="Org.jed" minWidth="20" />
        <CSComboBox fx:id="cbDivision" initFactory="true" factoryMethodName="Name" HBox.hgrow="SOMETIMES" maxWidth="$maxComponentWidth" />
    </HBox>
    <CSTable fx:id="csTable"
        DTOName="Client"
        VBox.vgrow="ALWAYS"
        topLabelText="KLIJENTI"
        topLabelVisible="true"
        addButtonVisible="false"
        viewButtonVisible="false"
        editButtonVisible="false"
        deleteButtonVisible="false"
        searchVisible="true"
        searchTooltipText="Pretraga po: ŠIFRA, NAZIV, PIB, MB, DRUGI NAZIV, MESTO, ADRESA">
        <tableColumns>
            <CSTableColumn displayName="ŠIFRA" methodName="Id"/>
            <CSTableColumn displayName="NAZIV" methodName="Name" width="200"/>
            <CSTableColumn displayName="ADRESA" methodName="Address" width="200"/>
            <CSTableColumn displayName="PTT BROJ" methodName="PoBox" />
            <CSTableColumn displayName="MESTO" methodName="City" />
        </tableColumns>
    </CSTable>

</fx:root>
