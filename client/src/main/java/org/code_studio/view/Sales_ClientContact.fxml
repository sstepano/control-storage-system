<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>

<?import org.controlsfx.glyphfont.Glyph?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.ui.CSClientTable?>

<AnchorPane
    prefWidth="1024"
    prefHeight="850"
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">

        <HBox 
           AnchorPane.leftAnchor   ="0"
           AnchorPane.rightAnchor  ="0"
           AnchorPane.topAnchor    ="0"
           AnchorPane.bottomAnchor ="0">
           
	          <CSClientTable fx:id="tblClient" />
             
	          <CSTable fx:id="tblClientContact"
	              topLabelText="KONTAKTI"
	              DTOName="ClientContact" 
	              topSectionVisible="true" 
	              topLabelVisible="true"
	              searchVisible="false" 
	              searchTooltipText="%contactsform.mainTable.searchTooltipText"
	              viewButtonVisible="false"
	              HBox.hgrow="ALWAYS">
	              <tableColumns>
	                  <CSTableColumn displayName="ŠIFRA" methodName="Id" />
	                  <CSTableColumn displayName="TITULA" methodName="Title" width="120" />
	                  <CSTableColumn displayName="NAZIV" methodName="Name" width="120" />
	                  <CSTableColumn displayName="TELEFON" methodName="Phone" width="120" />
	                  <CSTableColumn displayName="FAX" methodName="Fax" width="120" />
	                  <CSTableColumn displayName="E-MAIL" methodName="Email" width="150" />
	                  <CSTableColumn displayName="NAPOMENA" methodName="Description" />
	              </tableColumns>
	          </CSTable>
        </HBox>
</AnchorPane>
