<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AnchorPane>

<?import java.lang.Integer?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.CSComboBox?>
<?import org.code_studio.component.ui.CSClientTable?>

<?import org.controlsfx.glyphfont.Glyph?>

<AnchorPane
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">
    
    <fx:define>
        <Integer fx:id="glyphFontSize" fx:value="36" />
        <Integer fx:id="buttonWidth" fx:value="150" />
    </fx:define>    
    
    <children>
        <VBox
            AnchorPane.leftAnchor   ="0"
            AnchorPane.rightAnchor  ="0"
            AnchorPane.topAnchor    ="0"
            AnchorPane.bottomAnchor ="0">
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
            <HBox>
                <CSClientTable fx:id="tblSupplier" supplier="true" viewButtonVisible="true" minWidth="270">
                    <tableColumns>
                        <CSTableColumn displayName="ŠIFRA" methodName="Id"/>
                        <CSTableColumn displayName="NAZIV" methodName="Name" width="200"/>
                    </tableColumns>
                </CSClientTable>
                <CSTable fx:id="tblOrder"
                    HBox.hgrow="ALWAYS"
                    DTOName="Orders"  
                    topLabelText="%orderForm.tblOrder.label"
                    addButtonVisible="true"
                    viewButtonVisible="false"
                    editButtonVisible="true"
                    deleteButtonVisible="false">
                    <componentBarItems>
                         <Label text="Status" />
                         <CSComboBox fx:id="cbOrderStatus" />
                    </componentBarItems>
                    <tableColumns>
                        <CSTableColumn displayName="ŠIFRA" methodName="Id" />
                        <CSTableColumn displayName="DATUM ORDERA" methodName="OrderDate" width="100" />
                        <!-- <CSTableColumn displayName="DOBAVLJAČ" methodName="ClientName" /> -->
                        <CSTableColumn displayName="KONTAKT" methodName="ContactInfo" />
                        <CSTableColumn displayName="POTVRĐEN" methodName="LoadingDate" width="100" />
                        <CSTableColumn displayName="ISPORUKA" methodName="DeliveryDate" width="100" />
                        <CSTableColumn displayName="PRIJEM" methodName="ReceiveDate" width="100" />
                        <CSTableColumn displayName="OTVOREN" methodName="OpenDate" width="100" />
                        <CSTableColumn displayName="OVEREN" methodName="ValidationDate" width="100" />
                        <CSTableColumn displayName="OVERIO" methodName="ValidatedByUserName" />
                    </tableColumns>
                </CSTable>
            </HBox>
            <HBox>
                <CSTable fx:id="tblOrdersDetail"
                    HBox.hgrow="ALWAYS"
                    DTOName="OrdersDetail" 
                    topLabelText="%orderForm.tblOrderDetail.label"
                    addButtonVisible="true"
                    viewButtonVisible="false"
                    editButtonVisible="false"
                    deleteButtonVisible="true">
                    <tableColumns>
                        <CSTableColumn displayName="ŠIFRA" methodName="Id" />
                        <CSTableColumn displayName="ŠIFRA ARTIKLA" methodName="ItemCode" />
                        <CSTableColumn displayName="NAZIV ARTIKLA" methodName="ItemName" width="300"/>
                        <CSTableColumn displayName="CENA" methodName="PurchasePrice" />
                        <CSTableColumn displayName="MIN.KOL." methodName="MinimumQty" />
                        <CSTableColumn displayName="SPEC" methodName="PurchasePriceSpec" />
                        <CSTableColumn displayName="PRICE" methodName="Price" />
                        <CSTableColumn displayName="ISP.KOL." methodName="DeliveredQty" />
                                                
                        <CSTableColumn displayName="VREDNOST" methodName="DeliveredQty" />
                        <CSTableColumn displayName="UKUPNO" methodName="DeliveredQty" />
                    </tableColumns>
                </CSTable>
	        </HBox>
	        <HBox>                    
	            <GridPane hgap="5" vgap="5" HBox.hgrow="ALWAYS" styleClass="gridpane-button-holder">
	            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
	                <Button fx:id="btnOrdered" GridPane.rowIndex="0" GridPane.columnIndex="0" prefWidth="$buttonWidth" text="%orderForm.button1.text" wrapText="true" disable="true">
	                    <graphic><Glyph styleClass="glyph" icon="ENVELOPE" textFill="BLACK" fontSize="$glyphFontSize"/></graphic>
	                </Button>
	                <Button fx:id="btnOrderConfirmation" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="$buttonWidth" text="Potvrda ordera" wrapText="true" disable="true">
	                    <graphic><Glyph styleClass="glyph" icon="HAND_ALT_RIGHT" textFill="black" fontSize="$glyphFontSize"/></graphic>
	                </Button>
	                <Button fx:id="btnExpectedDeliveryDate" GridPane.rowIndex="0" GridPane.columnIndex="2" prefWidth="$buttonWidth" text="%orderForm.button3.text" wrapText="true" textAlignment="CENTER" disable="true">
	                    <graphic><Glyph styleClass="glyph" icon="PLANE" textFill="black" fontSize="$glyphFontSize"/></graphic>
	                </Button>
	                <Button GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="$buttonWidth" text="%orderForm.button4.text" wrapText="true" textAlignment="CENTER">
	                    <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black" fontSize="$glyphFontSize"/></graphic>
	                </Button>
                    <Button GridPane.rowIndex="0" GridPane.columnIndex="4" prefWidth="$buttonWidth" text="%orderForm.button12.text" wrapText="true">
                        <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black" fontSize="$glyphFontSize"/></graphic>
                    </Button>
	                <Button fx:id="btnReceiveAndDebitReceivingWarehouse" GridPane.rowIndex="0" GridPane.columnIndex="5" GridPane.rowSpan="2" prefWidth="$buttonWidth" prefHeight="110"
	                        GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS" text="%orderForm.button5.text" wrapText="true" disable="true">
	                    <graphic><Glyph styleClass="glyph" icon="CHECK_SQUARE" textFill="GREEN" fontSize="$glyphFontSize"/></graphic>
	                </Button>
	                <Button GridPane.rowIndex="0" GridPane.columnIndex="6" prefWidth="$buttonWidth" text="%orderForm.button6.text" wrapText="true" textAlignment="CENTER">
	                    <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black" fontSize="$glyphFontSize"/></graphic>
	                </Button>
	                <Button fx:id="btnExport" GridPane.rowIndex="0" GridPane.columnIndex="7" GridPane.rowSpan="2" prefWidth="$buttonWidth" prefHeight="110" 
	                        text="Export" wrapText="true">
	                    <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black" fontSize="$glyphFontSize"/></graphic>
	                </Button>
	                <Button fx:id="btnFormBackorder" GridPane.rowIndex="1" GridPane.columnIndex="0" prefWidth="$buttonWidth" text="%orderForm.button9.text" wrapText="true" textAlignment="CENTER" disable="true">
	                    <graphic><Glyph styleClass="glyph" icon="CALENDAR_ALT" textFill="black" fontSize="$glyphFontSize"/></graphic>
	                </Button>
	                <HBox GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2">
	                    <VBox spacing="5" HBox.hgrow="ALWAYS">
	                        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
	                        <CheckBox text="Potpis" />
	                        <CheckBox text="Pečat" />
	                    </VBox>
	                    <HBox>
			                <Button text="%orderForm.button10.text" prefWidth="$buttonWidth" wrapText="true">
			                    <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black" fontSize="$glyphFontSize"/></graphic>
			                </Button>
		                </HBox>
	                </HBox>
	                <Button GridPane.rowIndex="1" GridPane.columnIndex="3" prefWidth="$buttonWidth" text="%orderForm.button11.text" wrapText="true">
	                    <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black" fontSize="$glyphFontSize"/></graphic>
	                </Button>
	                <Button GridPane.rowIndex="1" GridPane.columnIndex="4" prefWidth="$buttonWidth" text="%orderForm.button13.text" wrapText="true">
	                    <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black" fontSize="$glyphFontSize"/></graphic>
	                </Button>
	                <Button GridPane.rowIndex="1" GridPane.columnIndex="6" prefWidth="$buttonWidth" text="%orderForm.button8.text" wrapText="true" textAlignment="CENTER">
	                    <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black" fontSize="$glyphFontSize"/></graphic>
	                </Button>
	           </GridPane>
	        </HBox>
        </VBox>
    </children>        
</AnchorPane>
