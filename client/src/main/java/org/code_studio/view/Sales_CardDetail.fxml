<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AnchorPane>

<?import java.lang.Integer?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Spinner?>

<?import org.controlsfx.glyphfont.Glyph?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.CSDatePicker?>
<?import org.code_studio.component.CSComboBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">
    
    <fx:define>
        <Integer fx:id="textFieldWidth" fx:value="75" />
        <Integer fx:id="longTextFieldWidth" fx:value="200" />
        <Integer fx:id="comboboxWidth" fx:value="200" />
        <Integer fx:id="textareaHeight" fx:value="100" />
    </fx:define>

        <VBox
            AnchorPane.leftAnchor   ="0"
            AnchorPane.rightAnchor  ="0"
            AnchorPane.topAnchor    ="0"
            AnchorPane.bottomAnchor ="0">
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
            <CSTable fx:id="tblClientCard"
                topLabelText="DETALJI RAČUNA"
                DTOName="ClientAccountBalanceCard"
                topSectionVisible="true" 
                topLabelVisible="true"
                searchVisible="false"
                searchTooltipText=""
                addButtonVisible="false"
                editButtonVisible="false"
                viewButtonVisible="false"
                deleteButtonVisible="false" 
                VBox.vgrow="ALWAYS">
                <tableColumns>
                    <CSTableColumn displayName="DATUM VALUTE" methodName="ValueDate" />
                    <CSTableColumn displayName="DATUM KNJIŽENJA" methodName="BookingDate" />
                    <CSTableColumn displayName="IZNOS" methodName="Amount" width="100" />
                    <CSTableColumn displayName="SALDO" methodName="Saldo" width="100" />
                    <CSTableColumn displayName="BROJ IZVODA" methodName="BankStatementId" />
                    <CSTableColumn displayName="BROJ RAČUNA" methodName="InvoiceId" />
                    <CSTableColumn displayName="ŠIFRA KLIJENTA" methodName="ClientId" />
                </tableColumns>                   
            </CSTable>
        </VBox>
</AnchorPane>
