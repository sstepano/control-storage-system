<AnchorPane
    prefWidth="1024"
    prefHeight="600"
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css"
    fx:controller="org.code_studio.controller.Dobanovci_ShowDeclarationController">
    
    <fx:define>
        <Integer fx:id="glyphFontSize" fx:value="24" />
        <Integer fx:id="buttonWidth" fx:value="150" />
        <Integer fx:id="longButtonWidth" fx:value="170" />
    </fx:define>    
    
    <children>
        <VBox
            AnchorPane.leftAnchor   ="0"
            AnchorPane.rightAnchor  ="0"
            AnchorPane.topAnchor    ="0"
            AnchorPane.bottomAnchor ="0"
            spacing="5"
            >
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
            <HBox spacing="5">
                
                <HBox styleClass="box-with-border">
                    <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                    <VBox>
		                <Button fx:id="btn1" prefWidth="$longButtonWidth" text="Štampa lagera M16" alignment="CENTER_LEFT">
		                    <graphic><Glyph styleClass="glyph" icon="ENVELOPE" textFill="BLACK" fontSize="$glyphFontSize"/></graphic>
		                </Button>
                        <Button fx:id="btn1" prefWidth="$longButtonWidth" text="Štampa uputstva" alignment="CENTER_LEFT">
                            <graphic><Glyph styleClass="glyph" icon="ENVELOPE" textFill="BLACK" fontSize="$glyphFontSize"/></graphic>
                        </Button>
                        <Button fx:id="btn1" prefWidth="$longButtonWidth" text="Nalepnice GU 32x15 (2021)" alignment="CENTER_LEFT">
                            <graphic><Glyph styleClass="glyph" icon="ENVELOPE" textFill="BLACK" fontSize="$glyphFontSize"/></graphic>
                        </Button>
                    </VBox>
                    <VBox>
                        <Label text="Potrebna dokumenta"/>
                        <TextArea VBox.vgrow="ALWAYS" wrapText="true"/>
                    </VBox>                
                </HBox>
                
            </HBox>
            <HBox VBox.vgrow="SOMETIMES">
                <CSTable fx:id="tblBillOfLadingDetail"
                    HBox.hgrow="ALWAYS"
                    DTOName="ItemSet" 
                    topLabelText="ARTIKLI"
                    addButtonVisible="true"
                    viewButtonVisible="false"
                    editButtonVisible="true"
                    deleteButtonVisible="true">
                    <tableColumns>
                        <CSTableColumn displayName="NAZIV" methodName="Name" />
                    </tableColumns>
                </CSTable>
	        </HBox>

        </VBox>
    </children>        
</AnchorPane>
