<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE VBox>

<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.CheckBox?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.CSTextField?>
<?import org.code_studio.component.ui.CSComboBoxSalesOfficer?>
<?import org.code_studio.component.CSDatePicker?>

<?import org.controlsfx.glyphfont.Glyph?>

<VBox
    prefWidth="400"
    prefHeight="100"
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">

    <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
    
    <VBox styleClass="box-with-border" alignment="CENTER_LEFT">
        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
        <HBox alignment="CENTER_LEFT">
	        <Label text="Referent" />
	        <CSComboBoxSalesOfficer fx:id="cbSalesOfficer" prefWidth="150" />
	        <CheckBox fx:id="ckbAll" text="Svi" />
        </HBox>
        <HBox alignment="CENTER_LEFT">
	        <Label fx:id="lblDateFrom" text="Od datuma" />
	        <CSDatePicker fx:id="dtDateFrom" defaultToday="true" />
        </HBox>
        <HBox alignment="CENTER_LEFT" fx:id="hbDateTo">
	        <Label text="Do datuma" />
	        <CSDatePicker fx:id="dtDateTo" defaultToday="true" />
        </HBox>
    </VBox>

     <!-- SAVE | CANCEL BUTTONS -->
     <HBox spacing="10" alignment="BOTTOM_RIGHT">
         <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
         <Button fx:id="btnPrint" text="Štampa" visible="true">
             <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
         </Button>
         <Button fx:id="btnCancel" text="%button.close.text">
             <graphic><Glyph styleClass="glyph" icon="CLOSE" textFill="black"/></graphic>
         </Button>
     </HBox>
        
</VBox>
