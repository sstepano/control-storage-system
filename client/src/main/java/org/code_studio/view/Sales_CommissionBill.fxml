<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AnchorPane>

<?import java.lang.Integer?>
<?import java.lang.Double?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.CheckBox?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.CSTextField?>

<?import org.controlsfx.glyphfont.Glyph?>
<?import org.code_studio.component.CSDatePicker?>

<AnchorPane
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">
    
    <fx:define>
        <Integer fx:id="btnWidth" fx:value="160" />
        <Integer fx:id="smallTextFieldWidth" fx:value="75" />
        <Integer fx:id="mediumTextFieldWidth" fx:value="120" />
        <Double fx:id="DOUBLE_MAX_VALUE" fx:value="1.7976931348623157E308" />
        <ToggleGroup fx:id="tgpPrimerak" />
    </fx:define>
    
    <children>
        <VBox spacing="5" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor ="0">
            <HBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <padding><Insets top="5" right="5" bottom="0" left="5"/></padding>
                    <HBox styleClass="box-with-border" spacing="5" alignment="CENTER_LEFT">
                        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                        <Label text="Račun" />
                        <TextField text="00001" prefWidth="${smallTextFieldWidth}" />
                        <Button fx:id="btnOvera" text="Overa">
                            <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="yellow"/></graphic>
                        </Button>

                        <Label text="Otpremnica" />
                        <TextField text="00001" prefWidth="${smallTextFieldWidth}"/>
                        <Button fx:id="btnOvera" text="Overa">
                            <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="green"/></graphic>
                        </Button>

                        <Button fx:id="btnOvera" text="Otvaranje otpremnice">
                            <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                        </Button>
                    </HBox>

                    <HBox spacing="5">
                        <VBox HBox.hgrow="ALWAYS">
                            <CSTable fx:id="tblCommissionBill"
                                maxHeight="300"
                                HBox.hgrow="ALWAYS"
                                topLabelText="KOMISIONI RAČUN"
                                DTOName="VatGroup" 
                                topSectionVisible="true"
                                searchVisible="false"
                                viewButtonVisible="false"
                                VBox.vgrow="ALWAYS">
                                <tableColumns>
                                    <CSTableColumn displayName="ŠIFRA" methodName="Id" />
                                </tableColumns>                   
                            </CSTable>
                            <HBox alignment="CENTER" styleClass="box-with-border">
                                <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                                <Label text="Zaduženje"/>
                                <CSTextField text="0,00" prefWidth="${smallTextFieldWidth}" validationType="MONEY"/>
                                <Label text="Uplaćeno"/>
                                <CSTextField text="0,00" prefWidth="${smallTextFieldWidth}" validationType="MONEY"/>
                                <Label text="Saldo"/>
                                <CSTextField text="0,00" prefWidth="${smallTextFieldWidth}" validationType="MONEY"/>
                            </HBox>
                            <VBox styleClass="box-with-border">
                                <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Rok (datum)"/>
                                    <CSDatePicker prefWidth="${mediumTextFieldWidth}"/>
                                    <Label text="Rok (Vreme)"/>
                                    <CSTextField text="12:24" prefWidth="${smallTextFieldWidth}"/>
                                    <HBox fx:id="hboxFiller" HBox.hgrow="ALWAYS"></HBox>
                                    <Button fx:id="btnPrintPrenosnica" text="Prenosnica">
                                        <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                                    </Button>
                                </HBox>
                                <HBox prefWidth="100">
                                    <TextArea styleClass="blue-field" HBox.hgrow="SOMETIMES"/>
                                    <Button fx:id="btnSaveRok" text="Sačuvaj" maxHeight="${DOUBLE_MAX_VALUE}" maxWidth="${DOUBLE_MAX_VALUE}" HBox.hgrow="SOMETIMES">
                                        <graphic><Glyph styleClass="glyph" icon="SAVE" textFill="RED"/></graphic>
                                    </Button>
                                </HBox>
                            </VBox>                       
                        </VBox>

                        <VBox styleClass="box-with-border" spacing="5">
                            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                            <Button fx:id="btnOvera" text="Predračun" prefWidth="${btnWidth}" alignment="CENTER_LEFT">
                                <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                            </Button>
                            <Button fx:id="btnOvera" text="Račun" prefWidth="${btnWidth}" alignment="CENTER_LEFT">
                                <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                            </Button>
                            <Button fx:id="btnOvera" text="Račun-Otpremnica" prefWidth="${btnWidth}" alignment="CENTER_LEFT">
                                <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                            </Button>
                            <Button fx:id="btnOvera" text="Otpremnica" prefWidth="${btnWidth}" alignment="CENTER_LEFT">
                                <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                            </Button>
                            <Button fx:id="btnOvera" text="Otpremnica bez cena" prefWidth="${btnWidth}" alignment="CENTER_LEFT">
                                <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                            </Button>
                            <Button fx:id="btnOvera" text="Faktura u FK" prefWidth="${btnWidth}" alignment="CENTER_LEFT">
                                <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                            </Button>
                            <Button fx:id="btnOvera" text="Račun bez godine" prefWidth="${btnWidth}" alignment="CENTER_LEFT">
                                <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                            </Button>
                            <Button fx:id="btnOvera" text="Eksport" prefWidth="${btnWidth}" alignment="CENTER_LEFT">
                                <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                            </Button>
                        </VBox>
                        <VBox styleClass="box-with-border" spacing="5">
                            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                            <Label text="Primerak" />
                            <RadioButton text="Ništa" selected="true" toggleGroup="${tgpPrimerak}" />
                            <RadioButton text="Original" toggleGroup="${tgpPrimerak}" />
                            <RadioButton text="Kopija" toggleGroup="${tgpPrimerak}" />
                            
                            <CheckBox text="Sa pečatom" />
                            <CheckBox text="Sa barkodom" />
                            <CheckBox text="Iskazati rabat" />
                            <CheckBox text="Po DOM šifri" />
                        
                            <Button fx:id="btnOvera" text="Račun-Otpremnica bez godine" prefWidth="${btnWidth}" wrapText="true">
                                <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                            </Button>
                            <Button fx:id="btnOvera" text="XML Tehnomedija" prefWidth="${btnWidth}" alignment="CENTER_LEFT">
                                <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                            </Button>                            
                        </VBox>
                        
                        <!-- KLIJENT INFO -->
                        <VBox styleClass="box-with-border">
                            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                            <GridPane hgap="5" vgap="5">
                                <!--
                                 <columnConstraints>
                                     <ColumnConstraints prefWidth="60" />
                                     <ColumnConstraints prefWidth="${smallTextFieldWidth}" />
                                 </columnConstraints>
                                 -->                            
                            
                                <Label text="Šifra" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <TextField GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3" />
                                
                                <Label text="Naziv" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                <TextField GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3" />

                                <Label text="Pun naziv" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3" />

                                <Label text="P.broj" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                <TextField GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="3" />

                                <Label text="Mesto" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                                <TextField GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="3" />

                                <Label text="Adresa" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                                <TextField GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="3" />

                                <Label text="Zemlja" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                                <TextField GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.columnSpan="3" />

                                <Label text="Limit" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                                <TextField GridPane.rowIndex="7" GridPane.columnIndex="1" prefWidth="${smallTextFieldWidth}" />
                                <TextField GridPane.rowIndex="7" GridPane.columnIndex="2" prefWidth="${smallTextFieldWidth}" />
                                <TextField GridPane.rowIndex="7" GridPane.columnIndex="3" prefWidth="${smallTextFieldWidth}" />
                            </GridPane>
                            
                            <CSTable fx:id=""
                                maxHeight="250"
                                topLabelText="NEMAM POJMA"
                                DTOName="VatGroup"
                                topSectionVisible="false"
                                HBox.hgrow="ALWAYS">
                                <tableColumns>
                                    <CSTableColumn displayName="ŠIFRA" methodName="Id" />
                                </tableColumns>                   
                            </CSTable>
                        </VBox>
                    </HBox>

                </VBox>

                <VBox>
                </VBox>
            </HBox>
            
            <!-- DETAILS TABLE -->
            <VBox spacing="5">
                <padding><Insets top="0" right="5" bottom="5" left="5"/></padding>
                <CSTable fx:id="tblCommissionBillDetail"
                    topLabelText="DETALJI"
                    DTOName="VatGroup" 
                    topSectionVisible="true" 
                    topLabelVisible="true"
                    searchVisible="false"
                    viewButtonVisible="false" 
                    HBox.hgrow="ALWAYS">
                    <tableColumns>
                        <CSTableColumn displayName="ŠIFRA" methodName="Id" />
                    </tableColumns>                   
                </CSTable>
                <HBox>
                    <HBox>
                        <padding><Insets top="5" right="0" bottom="0" left="0"/></padding>
                        <Button fx:id="" text="Rabat račun">
                            <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                        </Button>
                        <Button fx:id="" text="Rabat stavka">
                            <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                        </Button>
                        <Button fx:id="" text="DOM ->">
                            <graphic><Glyph styleClass="glyph" icon="PRINT" textFill="black"/></graphic>
                        </Button>
                    </HBox>
                    <HBox HBox.hgrow="ALWAYS"></HBox>
                    <HBox styleClass="box-with-border" alignment="CENTER">
                        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                        <Label text="Broj stavki" />
                        <TextField text="0" />

                        <Label text="Ukupno" />
                        <TextField text="0.00" />
                    </HBox>
                </HBox>
            </VBox>
        </VBox>
    </children>        
</AnchorPane>
