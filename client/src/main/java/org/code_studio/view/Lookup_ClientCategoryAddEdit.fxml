<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AnchorPane>

<?import java.lang.Integer?>
<?import java.lang.Double?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>

<?import org.code_studio.component.CSTextField?>

<?import org.controlsfx.glyphfont.Glyph?>


<AnchorPane
    prefWidth="300"
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">
    
    <fx:define>
        <Double  fx:id="maxComponentWidth" fx:value="1.7976931348623157E308" />
        <Integer fx:id="shortTextFieldWidth" fx:value="50" />
        <Integer fx:id="textFieldWidth" fx:value="110" />
        <Integer fx:id="longTextFieldWidth" fx:value="200" />
        <Integer fx:id="shortDatePickerWidth" fx:value="75" />
        <Integer fx:id="datePickerWidth" fx:value="100" />
    </fx:define>

    <HBox
        AnchorPane.leftAnchor   ="0"
        AnchorPane.rightAnchor  ="0"
        AnchorPane.topAnchor    ="0"
        AnchorPane.bottomAnchor ="0">
        <VBox spacing="15">
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                
            <VBox spacing="5" alignment="CENTER_LEFT" styleClass="box-with-border">
                <!--
                <HBox styleClass="box-header" alignment="CENTER">
                    <Label text="DODAVANJE ARTIKLA U CENOVNIK"></Label>
                </HBox>
                -->
                
                <GridPane hgap="5" vgap="5">
                    <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>

                    <Label GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.Halignment="RIGHT" text="Šifra" />
                    <CSTextField fx:id="tfId" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="$shortTextFieldWidth" text="AUTO" disable="true"/>

                    <Label GridPane.rowIndex="0" GridPane.columnIndex="2" GridPane.Halignment="RIGHT" text="Naziv" />
                    <CSTextField fx:id="tfName" GridPane.rowIndex="0" GridPane.columnIndex="3" />
                    
                    <Label GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.Halignment="LEFT" text="Opis" />
                    <TextArea fx:id="taDescription" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="4" />

                </GridPane>
            </VBox>
                

            <!-- SAVE | CANCEL BUTTONS -->
            <HBox spacing="10" alignment="BOTTOM_RIGHT">
               <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                   <Button fx:id="btnSave" text="%button.save.text" disable="true">
                       <graphic><Glyph styleClass="glyph" icon="SAVE" textFill="black"/></graphic>
                   </Button>
                   <Button fx:id="btnCancel" text="%button.cancel.text">
                       <graphic><Glyph styleClass="glyph" icon="CLOSE" textFill="black"/></graphic>
                   </Button>
            </HBox>
        </VBox>
    </HBox>
</AnchorPane>
