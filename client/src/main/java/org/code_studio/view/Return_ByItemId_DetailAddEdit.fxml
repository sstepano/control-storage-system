<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AnchorPane>

<?import java.lang.Integer?>
<?import java.lang.Double?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.CheckBox?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.CSTextField?>

<?import org.controlsfx.glyphfont.Glyph?>
<?import org.code_studio.component.CSDatePicker?>

<AnchorPane
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">
    
    <fx:define>
        <Integer fx:id="btnWidth" fx:value="160" />
        <Integer fx:id="smallTextFieldWidth" fx:value="75" />
        <Integer fx:id="mediumTextFieldWidth" fx:value="120" />
        <Double fx:id="DOUBLE_MAX_VALUE" fx:value="1.7976931348623157E308" />
        <ToggleGroup fx:id="tgpPrimerak" />
    </fx:define>

    <VBox AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor ="0">
        
	    <HBox alignment="CENTER_RIGHT">
	        <padding><Insets top="5" right="5" bottom="0" left="5"/></padding>
	        <Label text="Šifra artikla" />
	        <TextField fx:id="tfOrderId" prefWidth="$mediumTextFieldWidth" />
	    </HBox>
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="0" right="5" bottom="0" left="5"/></padding>
            <Label text="Bar kod" />
            <TextField fx:id="tfOrderId" prefWidth="$mediumTextFieldWidth" disable="true" />
        </HBox>
        
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="0" right="5" bottom="0" left="5"/></padding>
            <Label text="DOM šifra" />
            <TextField fx:id="tfOrderId" prefWidth="$mediumTextFieldWidth" />
        </HBox>
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="0" right="5" bottom="0" left="5"/></padding>
            <Label text="Količina" />
            <TextField fx:id="tfOrderId" prefWidth="$mediumTextFieldWidth" />
        </HBox>
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="0" right="5" bottom="0" left="5"/></padding>
            <Label text="Red" />
            <TextField fx:id="tfOrderId" prefWidth="$smallTextFieldWidth" />
        </HBox>
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="0" right="5" bottom="0" left="5"/></padding>
            <Label text="Vertikala" />
            <TextField fx:id="tfOrderId" prefWidth="$smallTextFieldWidth" />
        </HBox>
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="0" right="5" bottom="0" left="5"/></padding>
            <Label text="Polica" />
            <TextField fx:id="tfOrderId" prefWidth="$smallTextFieldWidth" />
        </HBox>
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="0" right="5" bottom="0" left="5"/></padding>
            <Label text="Magacin prijema" />
            <TextField fx:id="tfOrderId" prefWidth="$smallTextFieldWidth" />
        </HBox>
        
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="0" right="5" bottom="0" left="5"/></padding>
            <Label text="Broj dokumenta" />
            <TextField fx:id="tfOrderId" prefWidth="$mediumTextFieldWidth" />
        </HBox>
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="0" right="5" bottom="0" left="5"/></padding>
            <Label text="Datum dokumenta" />
            <TextField fx:id="tfOrderId" prefWidth="$mediumTextFieldWidth" />
        </HBox>
        
        
        <!-- SAVE | CANCEL BUTTONS -->
        <HBox spacing="15" alignment="BOTTOM_RIGHT">
           <padding><Insets top="15" right="5" bottom="5" left="5"/></padding>
            <children>                    
               <Button fx:id="btnSave" text="%button.save.text">
                   <graphic><Glyph styleClass="glyph" icon="SAVE" textFill="black"/></graphic>
               </Button>
               <Button fx:id="btnCancel" text="%button.cancel.text">
                   <graphic><Glyph styleClass="glyph" icon="CLOSE" textFill="black"/></graphic>
               </Button>
            </children>
        </HBox>
        

    </VBox>

</AnchorPane>
