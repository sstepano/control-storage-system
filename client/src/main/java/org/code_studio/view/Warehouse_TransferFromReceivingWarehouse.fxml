<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>

<?import org.controlsfx.glyphfont.Glyph?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane
    prefWidth="1024"
    prefHeight="850"
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">
    
    <children>
        <VBox 
            AnchorPane.leftAnchor   ="0"
            AnchorPane.rightAnchor  ="0"
            AnchorPane.topAnchor    ="0"
            AnchorPane.bottomAnchor ="0"
            spacing="5">
                <HBox styleClass="box-with-border" alignment="CENTER_LEFT" spacing="5">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Button fx:id="btnCancel" text="Pojedinačni izbor">
                        <graphic><Glyph styleClass="glyph" icon="CHECK_SQUARE" textFill="black"/></graphic>
                    </Button>
                    <Label text="Magacin prijema"/>
                    <ComboBox minWidth="200"/>
                    <Button fx:id="btnCancel" text="Razduženje magacina za izabrane artikle i prepis u prijemnicu">
                        <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="bi-diamond"/></graphic>
                    </Button>
                </HBox>
	            <CSTable fx:id="mainTable"
	                     DTOName="Warehouse"
	                     VBox.vgrow="ALWAYS"
                         topLabelText="PRENOS IZ PRIJEMNOG MAGACINA"
                         topSectionVisible="false"  
                         tableRequestFocus="true">
                </CSTable>
        </VBox>
    </children>
</AnchorPane>
