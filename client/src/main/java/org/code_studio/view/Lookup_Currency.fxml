<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Button?>
<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>
<?import org.controlsfx.glyphfont.Glyph?>

<AnchorPane
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">
    
    <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
    <children>
        <VBox spacing="5"
           AnchorPane.leftAnchor   ="0"
           AnchorPane.rightAnchor  ="0"
           AnchorPane.topAnchor    ="0"
           AnchorPane.bottomAnchor ="0">
             <children>
		           <CSTable fx:id="mainTable"
                        DTOName="Currency" 
                        topSectionVisible="true" 
                        topLabelVisible="false"
                        searchVisible="false" 
                        tableRequestFocus="true"
                        viewButtonVisible="false"
                        VBox.vgrow="ALWAYS">
                       <columnResizePolicy><CSTable fx:constant="LASTCOLUMN_RESIZE_POLICY"/></columnResizePolicy>
                       <tableColumns>
	                       <CSTableColumn displayName="ŠIFRA" methodName="Id" />
                           <CSTableColumn displayName="ISO KOD" methodName="IsoCurrencyCode" />
                           <CSTableColumn displayName="NAPOMENA" methodName="Description" />
                           <CSTableColumn displayName="SIMBOL VALUTE" methodName="Symbol" />
                            <!-- ovo cu naknadno da dodam, kada dodam u sve entitije
	                       <CSTableColumn displayName="DATUM POSLEDNJEG LOGOVANJA" methodName="IsActive" />
                           <CSTableColumn displayName="DATUM POSLEDNJEG LOGOVANJA" methodName="IsDeleted" />
                           <CSTableColumn displayName="DATUM POSLEDNJEG LOGOVANJA" methodName="LastModifiedBy" />
                           <CSTableColumn displayName="DATUM POSLEDNJEG LOGOVANJA" methodName="LastModifiedTimestamp" />
                           -->
                       </tableColumns>                   
                   </CSTable>
             </children>
        </VBox>
    </children>        
</AnchorPane>
