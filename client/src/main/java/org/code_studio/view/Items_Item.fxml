<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.Button?>

<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.ui.CSClientTable?>
<?import org.code_studio.component.ui.CSItemTable?>

<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import org.controlsfx.glyphfont.Glyph?>

<AnchorPane
    prefWidth="1024"
    prefHeight="600"
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">
    <VBox
        AnchorPane.leftAnchor   ="0"
        AnchorPane.rightAnchor  ="0"
        AnchorPane.topAnchor    ="0"
        AnchorPane.bottomAnchor ="0"
        spacing="5">
        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
        <HBox VBox.vgrow="ALWAYS">
            <CSClientTable fx:id="tblSupplier" supplier="true" minWidth="250"/>
            <CSItemTable 
                fx:id="tblItem" 
                HBox.hgrow="ALWAYS"
                addButtonVisible="true"
                editButtonVisible="true"
                rowCheckboxVisible="false"
                ckbShowInStockOnlyVisible="false">
	            <tableColumns>
	                <CSTableColumn displayName="ŠIFRA" methodName="Code" />
	                <CSTableColumn displayName="NAZIV" methodName="Name" />
	                <CSTableColumn displayName="RM-D SPEC" methodName="GrossPriceRmD" />
	                <CSTableColumn displayName="DIS NETO SPEC" methodName="NetPriceRmD" />
	                <CSTableColumn displayName="DIS BRUTO SPEC" methodName="GrossPriceD" />
	                <CSTableColumn displayName="NETO-D SPEC" methodName="NetPriceDFak" />
	                <CSTableColumn displayName="BRUTO-D SPEC" methodName="GrossPriceDFak" />
	                <CSTableColumn displayName="PAKOVANJE" methodName="Packaging" tooltip="MB:Masterbox|CB:Cardbox|PL:Palette|CT:Container" />
	            </tableColumns>
            </CSItemTable>
        </HBox>        
    </VBox>
</AnchorPane>
