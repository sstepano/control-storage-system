<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AnchorPane>

<?import java.lang.Integer?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>

<?import org.controlsfx.glyphfont.Glyph?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import org.code_studio.component.ui.CSDialogButtons?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.CSTextField?>

<AnchorPane
    prefWidth="1010"
    prefHeight="705"
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css, @Warehouse_IssuingItemsManualIssuing.css">
    
    <fx:define>
        <Integer fx:id="shortTextFieldWidth" fx:value="75" />
        <Integer fx:id="textFieldWidth" fx:value="200" />
        <Integer fx:id="longTextFieldWidth" fx:value="200" />
    </fx:define>
    
    <children>
        <VBox
           AnchorPane.leftAnchor   ="0"
           AnchorPane.rightAnchor  ="0"
           AnchorPane.topAnchor    ="0"
           AnchorPane.bottomAnchor ="0"
           spacing="5">
           <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
           <children>

               <!-- DETALJI ARTIKLA -->                    
	           <HBox styleClass="box-with-border" alignment="CENTER">
		               <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
		               <Label text="Barkod" />
		               <CSTextField fx:id="tfBarcode" prefWidth="$textFieldWidth" alignment="CENTER" />

		               <CheckBox fx:id="ckbDisplayOnlyUnissued" text="Samo neizdato" />
	                   
	                   <Button fx:id="btnIssueSelectedItem" text="Izdato 1">
                           <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="bi-check" iconColor="GREEN" iconSize="26"/></graphic>
	                   </Button>
	                   <Button fx:id="btnRevertSelectedItem" text="Poništi 1">
	                       <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="bi-x" iconColor="RED" iconSize="26"/></graphic>
	                   </Button>
	
	                   <Button fx:id="btnIssueAllItems" text="Izdato SVE">
	                       <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="bi-check-all" iconColor="GREEN" iconSize="26"/></graphic>
	                   </Button>
	                   <Button fx:id="btnRevertAllItems" text="Poništi SVE">
	                       <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="bi-x-circle" iconColor="RED" iconSize="26"/></graphic>
	                   </Button>
               </HBox>
               
               <HBox styleClass="box-with-border" alignment="CENTER">
                   <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                   <Label text="Poslednji unos" />
		           <CSTextField fx:id="tfLastEntry" HBox.hgrow="ALWAYS" styleClass="darkkhaki-background" />
               </HBox>
                    
               <!-- TransferOrderDetail -->
               <CSTable 
                   fx:id="tblTransferOrderDetail"
                   dTOName="TransferOrderDetail" 
                   VBox.vgrow="ALWAYS" 
                   topLabelText="DETALJI PRENOSNICE"
                   topSectionVisible="false">
                   <tableColumns>
                       <CSTableColumn displayName="ŠIFRA ARTIKLA" methodName="ItemCode" width="300" />
                       <!-- <CSTableColumn displayName="NAZIV ARTIKLA" methodName="ItemName" width="400" /> -->
                       <CSTableColumn displayName="IZ" methodName="WarehouseIdOrigin" />
                       <CSTableColumn displayName="KOLIČINA" methodName="Qty" width="120" />
                       <CSTableColumn displayName="IZDATO" methodName="IssuedQty" width="120" />
                       <CSTableColumn displayName="RAZLIKA" methodName="QtyDifference" conditionalFormattingParams="neq,0,4,0,red" width="120" /> 
                       <CSTableColumn displayName="BARKOD" methodName="Barcode" />
                   </tableColumns>
               </CSTable>          
               
               <!-- UKUPNO, SREDNJI RED -->                    
               <HBox spacing="5" styleClass="box-with-border, darkkhaki-background" alignment="CENTER">
                   <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                   <Label text="Ukupno"></Label>
                   <CSTextField fx:id="tfTotalQty" prefWidth="$shortTextFieldWidth" validationType="NUMBER_ONLY" disable="true" />
                   <Label text="Izdato"></Label>
                   <CSTextField fx:id="tfTotalIssuedQty" prefWidth="$shortTextFieldWidth" validationType="NUMBER_ONLY" disable="true" />
               </HBox>

			   <CSDialogButtons fx:id="dialogButtons" />

            </children>
        </VBox>
    </children>        
</AnchorPane>
