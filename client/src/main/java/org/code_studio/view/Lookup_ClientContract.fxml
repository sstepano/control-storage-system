<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AnchorPane>

<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>

<?import org.code_studio.component.ui.CSDialogButtons?>

<AnchorPane
    prefWidth="1000"
    prefHeight="600"
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">
    <VBox
        AnchorPane.leftAnchor   ="0"
        AnchorPane.rightAnchor  ="0"
        AnchorPane.topAnchor    ="0"
        AnchorPane.bottomAnchor ="0">
        <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
        
         <!-- Ne dozvoljavamo brisanje jer verovatno ima klijenata koji pripadaju grupama -->
        <CSTable fx:id="tblClientContract"
            DTOName="ClientContract" 
            topSectionVisible="true"
            topLabelText="UGOVORI"
            viewButtonVisible="false"
            VBox.vgrow="ALWAYS">
            <tableColumns>
                <CSTableColumn displayName="ŠIFRA" methodName="Id" />
                <CSTableColumn displayName="BROJ" methodName="ContractNumber" />
                <CSTableColumn displayName="VAZI OD" methodName="ValidFrom" />
                <CSTableColumn displayName="VAZI DO" methodName="ValidTo" />
                <CSTableColumn displayName="NAPOMENA" methodName="Description" width="250"/>
            </tableColumns>                   
        </CSTable>
    
		<CSDialogButtons fx:id="dialogButtons" saveButtonVisible="false" cancelButtonText="Zatvori" />
		
    </VBox>
</AnchorPane>
