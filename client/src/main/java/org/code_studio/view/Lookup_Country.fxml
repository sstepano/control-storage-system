<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Button?>
<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>
<?import org.controlsfx.glyphfont.Glyph?>

<AnchorPane
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">

    <children>
        <VBox spacing="5"
           AnchorPane.leftAnchor   ="0"
           AnchorPane.rightAnchor  ="0"
           AnchorPane.topAnchor    ="0"
           AnchorPane.bottomAnchor ="0">
           <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
           <children>
		           <CSTable fx:id="mainTable"
                       topLabelText="%menubar.menu5.submenu5.text"
                       DTOName="Country" 
                       topSectionVisible="true" 
                       topLabelVisible="false"
                       searchVisible="true" 
                       searchTooltipText="%contactsform.mainTable.searchTooltipText"
                       tableRequestFocus="true"
                       VBox.vgrow="ALWAYS">
                       <columnResizePolicy><CSTable fx:constant="LASTCOLUMN_RESIZE_POLICY"/></columnResizePolicy>
                       <tableColumns>
	                       <CSTableColumn displayName="ŠIFRA" methodName="Id" />
                           <CSTableColumn displayName="ŠIFRA ZEMLJE" methodName="Code" />
                           <CSTableColumn displayName="NAZIV ZEMLJE" methodName="Name" />
                       </tableColumns>                   
                   </CSTable>
             </children>
        </VBox>
    </children>        
</AnchorPane>
