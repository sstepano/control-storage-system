<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AnchorPane>

<?import java.lang.Integer?>
<?import java.lang.Double?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.RadioButton?>

<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.CSComboBox?>
<?import org.code_studio.component.CSTextField?>
<?import org.code_studio.component.CSPrintButton?>

<?import org.code_studio.component.ui.CSComboBoxWarehouse?>
<?import org.code_studio.component.ui.CSComboBoxEnumerator?>
<?import org.code_studio.component.ui.CSDialogButtons?>

<AnchorPane
    prefWidth="1000"
    prefHeight="700"
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">
 
    <fx:define>
		<Double fx:id="DOUBLE_MAX_VALUE" fx:value="1.7976931348623157E308" /> 
        <Integer fx:id="iconSize" fx:value="16" />
        <Integer fx:id="btnWidth" fx:value="120" />
        <Integer fx:id="longComboBoxWidth" fx:value="200" />
        <ToggleGroup fx:id="tgpStatus" />
        <Integer fx:id="textFieldWidth" fx:value="50" />
    </fx:define> 

        <VBox
           AnchorPane.leftAnchor   ="0"
           AnchorPane.rightAnchor  ="0"
           AnchorPane.topAnchor    ="0"
           AnchorPane.bottomAnchor ="0"
           spacing="5">
           <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
      
               <!-- MAIN TABLE -->
               <VBox VBox.vgrow="ALWAYS">
                   <HBox>
			           <HBox alignment="CENTER_LEFT" styleClass="box-with-border, box-spacing-10">
			               <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
			               <RadioButton text="Razlike" toggleGroup="${tgpStatus}" selected="true" />
			               <RadioButton text="Sve" toggleGroup="${tgpStatus}" />
			               <RadioButton text="Nepopisano" toggleGroup="${tgpStatus}" />
	                   </HBox>
		               <HBox alignment="CENTER_LEFT" styleClass="box-with-border, box-padding-5" HBox.hgrow="ALWAYS">
		                   <Label text="Magacin" />
	                       <CSComboBoxWarehouse fx:id="cbWarehouse" />
	                       <!--
		                   <Label text="Popisivač" />
	                       <CSComboBoxEnumerator fx:id="cbEnumerator" mode="0" prefWidth="$longComboBoxWidth" />
	                       -->
	                   </HBox>
                   </HBox>
                   
                   <CSTable 
                       fx:id="tblInventoryListingDetailSum"
                       DTOName="InventoryListingDetailSum"  
                       topLabelText="VERIFIKACIJA POPISA"
                       addButtonVisible="false"
                       viewButtonVisible="false"
                       editButtonVisible="false"
                       deleteButtonVisible="false"
                       searchVisible="true"
                       searchTooltipText="Pretraga po: ŠIFRA ARTIKLA"
                       VBox.vgrow="ALWAYS"
                       autoNumberColumnVisible="true">
                       <tableColumns>
                           <!--  <CSTableColumn displayName="ID" methodName="Id" /> ID vec imamo kao autonumber column -->
                           <CSTableColumn displayName="ŠIFRA ARTIKLA" methodName="ItemId" />
                           <CSTableColumn displayName="LAGER" methodName="Qty" />
                           <CSTableColumn displayName="RED" methodName="RowId" width="30" />
                           <CSTableColumn displayName="DUBINA" methodName="ShelfId" />
                           <CSTableColumn displayName="VISINA" methodName="VerticalId" />
                           <CSTableColumn displayName="POPISANO" methodName="CountedQty" />
                           <CSTableColumn displayName="RAZLIKA" methodName="DifferenceQty" conditionalFormattingParams="neq,0" />
                       </tableColumns>
                   </CSTable>

                   <CSTable 
                       fx:id="tblInventoryListingDetail"
                       DTOName="InventoryListingDetail"  
                       topLabelText="VERIFIKACIJA POPISA - DETALJI"
                       addButtonVisible="false"
                       viewButtonVisible="false"
                       editButtonVisible="true"
                       deleteButtonVisible="false"
                       searchVisible="false"
                       VBox.vgrow="ALWAYS">
                       <tableColumns>
                           <CSTableColumn displayName="ID" methodName="Id" conditionalFormattingParams="eq,null,8,0,red" />
                           <CSTableColumn displayName="ŠIFRA ARTIKLA" methodName="ItemId" />
                           <CSTableColumn displayName="BARKOD" methodName="ItemBarcode" />
                           <CSTableColumn displayName="BROJANJE" methodName="CountingNbr" />
                           <!--
                            Ne prikazujem dok B. ne zatrazi.
                           <CSTableColumn displayName="LAGER" methodName="Id" />
                           -->
                           <CSTableColumn displayName="RED" methodName="RowId" width="30" />
                           <CSTableColumn displayName="DUBINA" methodName="ShelfId" />
                           <CSTableColumn displayName="VISINA" methodName="VerticalId" />
                           <CSTableColumn displayName="MAGACIN" methodName="WarehouseName" />
                           <CSTableColumn displayName="POPISANO" methodName="CountedQty" />
                           <!-- 
                             Ne prikazujem dok B. ne zatrazi.
                             Ovde moram da nekako prosledim lager u detail i onda da pravim transient metodu diffQty
                           <CSTableColumn displayName="RAZLIKA" methodName="Id" />
                           -->
                           <CSTableColumn displayName="POPISIVAČ" methodName="EnumeratorUsername" />
                           <CSTableColumn displayName="PRIHVAĆENO" methodName="Accepted" />
                       </tableColumns>
                   </CSTable>

                   <HBox alignment="CENTER" styleClass="box-with-border">
                       <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
	                   <Label text="STANJE" />
	                   <CSTextField fx:id="tfQty" validationType="NUMBER_ONLY" prefWidth="$textFieldWidth" />
	                   <Label text="POPISANO" />
	                   <CSTextField fx:id="tfSum" validationType="NUMBER_ONLY" styleClass="box-with-border" prefWidth="$textFieldWidth" />
                   </HBox>
                   <HBox>
			           <HBox alignment="CENTER_LEFT" styleClass="box-with-border, box-spacing-10">
			               <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                           <CSPrintButton fx:id="btnReportMinuses" text="Minusi" reportName="inventory_listing_differences" minWidth="$btnWidth" disable="true">
                               <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="mdi2p-printer" iconSize="$iconSize" iconColor="RED"/></graphic>
                           </CSPrintButton>
                           <CSPrintButton fx:id="btnReportPluses" text="Plusevi" reportName="inventory_listing_differences" minWidth="$btnWidth" disable="true">
                               <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="mdi2p-printer" iconSize="$iconSize" iconColor="GREEN"/></graphic>
                           </CSPrintButton>
                           <CSPrintButton fx:id="btnReportAllDifferences" text="Sve razlike" reportName="inventory_listing_differences" minWidth="$btnWidth" disable="true">
                               <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="mdi2p-printer" iconSize="$iconSize" iconColor="BLUE"/></graphic>
                           </CSPrintButton>
	                   </HBox>
		               <HBox alignment="CENTER_LEFT" styleClass="box-with-border, box-spacing-10" HBox.hgrow="ALWAYS">
		                   <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
                           <Button fx:id="btnCreateAllListings" text="Svi nalozi - RAZLIKE" disable="true">
                               <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="mdi2b-barcode-scan" iconSize="$iconSize" iconColor="RED"/></graphic>
                           </Button>
                           <Button fx:id="btnCreateOneListing" text="Nalog - novo brojanje" disable="true">
                               <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="mdi2b-barcode-scan" iconSize="$iconSize" iconColor="RED"/></graphic>
                           </Button>
                           <!--
                           <Button fx:id="" text="Prihvati brojanje" disable="true">
                               <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="mdi2b-barcode-scan" iconSize="$iconSize" iconColor="RED"/></graphic>
                           </Button>
                           <Button fx:id="btnChangeEnumeratedCount" text="Izmeni popisanu količinu" maxWidth="$DOUBLE_MAX_VALUE">
                               <graphic><FontIcon styleClass="glyph-ikonli" iconLiteral="mdi2b-barcode-scan" iconSize="$iconSize" iconColor="RED"/></graphic>
                           </Button>
                           -->
	                   </HBox>
                   </HBox>
               </VBox>
			   <CSDialogButtons fx:id="dialogButtons" saveButtonVisible="false" />
        </VBox>
</AnchorPane>
