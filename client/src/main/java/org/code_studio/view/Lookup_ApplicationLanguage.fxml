<AnchorPane
    prefWidth="800"
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css"
    fx:controller="org.code_studio.controller.Lookup_ApplicationLanguageController">
    <children>
        <VBox 
           AnchorPane.leftAnchor   ="0"
           AnchorPane.rightAnchor  ="0"
           AnchorPane.topAnchor    ="0"
           AnchorPane.bottomAnchor ="0">
             <children>
		           <CSTable fx:id="mainTable"
                        topLabelText="%menubar.menu5.submenu5.text"
                        DTOName="ApplicationLanguage" 
                        topSectionVisible="true" 
                        topLabelVisible="false"
                        searchVisible="true" 
                        searchTooltipText="%contactsform.mainTable.searchTooltipText"
                        tableRequestFocus="true"
                        VBox.vgrow="ALWAYS"
                    >
                       <tableColumns>
	                       <CSTableColumn displayName="ŠIFRA" methodName="Id" />
                           <CSTableColumn displayName="ŠIFRA JEZIKA" methodName="Code" />
                           <CSTableColumn displayName="NAZIV" methodName="Name" />
	                       <CSTableColumn displayName="NAPOMENA" methodName="Description" />
                       </tableColumns>                   
                   </CSTable>
             </children>
        </VBox>
    </children>        
</AnchorPane>
