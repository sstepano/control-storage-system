<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Button?>
<?import org.code_studio.component.CSTable?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>
<?import org.controlsfx.glyphfont.Glyph?>

<AnchorPane
    prefWidth="800"
    prefHeight="600"
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css">
    <children>
        <VBox 
           AnchorPane.leftAnchor   ="0"
           AnchorPane.rightAnchor  ="0"
           AnchorPane.topAnchor    ="0"
           AnchorPane.bottomAnchor ="0">
           <children>
           
                <!-- MAIN TABLE -->
				<CSTable 
				   fx:id="tblReservation" 
				   VBox.vgrow="ALWAYS" 
				   topLabelText="%label.reservation.text"
				   topSectionVisible="false">
				</CSTable>
	               
				<!-- SAVE | CANCEL BUTTONS -->
				<HBox spacing="10" alignment="BOTTOM_RIGHT">
				   <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
				    <children>
				       <!--
				       <Button fx:id="btnSave" text="%orderForm.button2.text">
				           <graphic><Glyph styleClass="glyph" icon="CHECK_CIRCLE" textFill="GREEN"/></graphic>
				       </Button>
				       -->
				       <Button fx:id="btnCancel" text="%button.close.text">
				           <graphic><Glyph styleClass="glyph" icon="CLOSE" textFill="black"/></graphic>
				       </Button>
				    </children>
				</HBox>	               
	               
           </children>
        </VBox>
    </children>        
</AnchorPane>
