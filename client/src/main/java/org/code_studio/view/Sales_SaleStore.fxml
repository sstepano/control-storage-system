<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.Integer?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>


<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>

<?import org.code_studio.component.CSTable?>
<?import org.code_studio.component.CSTableColumn?>
<?import org.code_studio.component.CSTextField?>

<?import org.controlsfx.glyphfont.Glyph?>

<AnchorPane
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml"
    stylesheets="@Main.css"
    prefWidth="1000">
    
    <fx:define>
        <Integer fx:id="shortTextFieldWidth" fx:value="75" />
        <Integer fx:id="textFieldWidth" fx:value="160" />
        <Integer fx:id="buttonWidth" fx:value="120" />
    </fx:define>
    
    <VBox AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor ="0">
        <HBox VBox.vgrow="ALWAYS">
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>

            <CSTable fx:id="tblClient"
                topLabelText="KLIJENTI"
                DTOName="Client" 
                topSectionVisible="true" 
                topLabelVisible="true"
                searchVisible="true"
                searchTooltipText="Pretraga po sifri, nazivu"
                addButtonVisible="false"
                editButtonVisible="false"
                viewButtonVisible="false"
                deleteButtonVisible="false" 
                VBox.vgrow="ALWAYS">
                <tableColumns>
                    <CSTableColumn displayName="ŠIFRA" methodName="Id" />
                    <CSTableColumn displayName="NAZIV" methodName="Name" width="200" />
                </tableColumns>                   
            </CSTable>

            <CSTable fx:id="tblClientSaleStore"
                topLabelText="PRODAVNICE"
                DTOName="ClientStore" 
                topSectionVisible="true" 
                topLabelVisible="true"
                searchVisible="false"
                searchTooltipText=""
                addButtonVisible="true"
                editButtonVisible="true"
                viewButtonVisible="false"
                deleteButtonVisible="true" 
                tableRequestFocus="true"
                HBox.hgrow="ALWAYS">
                <tableColumns>
                    <CSTableColumn displayName="ŠIFRA" methodName="Id" />
                    <CSTableColumn displayName="NAZIV" methodName="Name" width="150" />
                    <CSTableColumn displayName="MESTO" methodName="City" width="200" />
                    <CSTableColumn displayName="ADRESA" methodName="Address" width="300" />
                </tableColumns>                   
            </CSTable>
        </HBox>
    </VBox>        
</AnchorPane>
